    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "python tools/validate_offline.py"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
