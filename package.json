{
  "name": "stargazer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "斜视 / 集合不足 眼动评估本地 demo：普通摄像头 + MediaPipe + 相对偏斜角测量",
  "scripts": {
    "prepare-assets": "node tools/prepare-assets.mjs",
    "dev": "vite",
    "dev:https": "vite --mode https",
